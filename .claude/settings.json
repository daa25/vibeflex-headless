{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm lint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(node scripts/vibeflex-doctor.mjs:*)",
      "Bash(bash scripts/bootstrap-claude.sh:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/credentials)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Read(**/secrets.json)",
      "Read(**/*secret*.json)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(.supabase/**)"
    ]
  }
}
