{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/id_rsa*)",
      "Read(./**/credentials)",
      "Read(./**/credentials.json)",
      "Read(./**/service-account*.json)",
      "Read(./**/secrets.json)",
      "Read(./**/*secret*.json)",
      "Read(./**/.npmrc)",
      "Read(./**/.netrc)",
      "Read(./.supabase/**)"
    ]
  }
}
