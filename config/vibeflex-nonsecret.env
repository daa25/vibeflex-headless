# VibeFlex POD Studio — non-secret configuration defaults.
#
# Loaded automatically by scripts/bootstrap-claude.sh. Values already present in
# the environment win, so a cloud environment or CI can override any line here.
#
# ─────────────────────────────────────────────────────────────────────────────
# NEVER put a credential in this file. It is committed to git and world-readable.
#
# Secrets live only in Supabase Edge Function secrets on project
# uluyuqrikzicapnezmqd. Add them with scripts/fix-supabase-secrets.sh.
# That means: no PRINTFUL_TOKEN, no SHOPIFY_CLIENT_SECRET, no SHOPIFY_ADMIN_TOKEN,
# no AIRTABLE_TOKEN, no SUPABASE_SERVICE_ROLE_KEY, no database passwords.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
VIBEFLEX_ENV=production
VIBEFLEX_INTERNAL_TENANT=490-movement

# These two Shopify domains are intentionally different. Do not collapse them:
#   SHOPIFY_API_DOMAIN    -> Admin API + OAuth (server-side only)
#   SHOPIFY_PUBLIC_DOMAIN -> customer-facing storefront links
SHOPIFY_API_DOMAIN=hbipmy-3g.myshopify.com
SHOPIFY_PUBLIC_DOMAIN=vibeflex-813.myshopify.com

AIRTABLE_BASE_ID=appuaF1jfeBr2PPqn

# Canonical POD runtime. The stale project whfbpjgqlsoshrvpsoua does not exist in
# this account's Supabase organization; bootstrap hard-fails if it reappears.
SUPABASE_PROJECT_REF=uluyuqrikzicapnezmqd
SUPABASE_PUBLIC_URL=https://uluyuqrikzicapnezmqd.supabase.co
